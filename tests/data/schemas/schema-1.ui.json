{
  "format": "py2tosc.ui",
  "schema": 1,
  "//": "The spellings the dialect shipped with. Nothing here may use anything a later schema introduced, since this file is what asserts schema 1 is still readable and still enough.",
  "root": {
    "column": [
      {"row": [
        {"fader": "ch$i", "messages": [{"osc": "/mix/{name}"}, {"midi_cc": "$i0"}], "repeat": 4}
      ], "gap": 4},
      {"row": [
        {"each": [
          {"n": "kick", "cc": 20},
          {"n": "snare", "cc": 24}
        ], "of": {"button": "$n", "messages": [{"midi_cc": "$cc"}]}}
      ], "gap": 4},
      {"grid": "BUTTON", "columns": 4, "rows": 1, "name": "mutes"}
    ],
    "sizes": [2, 1, 1], "gap": 8, "pad": 8, "name": "one",
    "frame": [0, 0, 800, 480]
  }
}
